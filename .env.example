# Copy to .env and fill in real values.

# --- Database -------------------------------------------------------------
# Local SQL Server (see docker-compose.yml):
DATABASE_URL="sqlserver://localhost:1433;database=fant;user=sa;password=FantLocal!2026;encrypt=true;trustServerCertificate=true"
#
# Azure SQL Database (production) looks like:
# DATABASE_URL="sqlserver://YOUR-SERVER.database.windows.net:1433;database=fant;user=YOUR-USER;password=YOUR-PASSWORD;encrypt=true;trustServerCertificate=false"

# --- Auth.js / NextAuth ---------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Required when deployed behind a host other than localhost/Vercel.
AUTH_TRUST_HOST="true"

# --- Microsoft Entra ID (Azure AD) ---------------------------------------
# Leave these blank for local development to bypass sign-in.
# Set all three in production to require Entra ID login.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Issuer URL. For a single-tenant app registration:
#   https://login.microsoftonline.com/<TENANT-ID>/v2.0
# For a multi-tenant app registration (any Microsoft work/school account):
#   https://login.microsoftonline.com/organizations/v2.0
# For any Microsoft account including personal:
#   https://login.microsoftonline.com/common/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# --- Access control ------------------------------------------------------
# Comma-separated. Email domains whose users are auto-approved on first
# sign-in. All other users are marked "pending" and must be approved by
# an administrator on the /admin/users page before they can use the app.
AUTH_ALLOWED_DOMAINS="wylie-law.com,fantaz.com"
# Comma-separated. Emails that are auto-approved AND made administrators.
# At least one entry is needed to bootstrap the first admin.
AUTH_ADMIN_EMAILS="jwylie@wylie-law.com"
